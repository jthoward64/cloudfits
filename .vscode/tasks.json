{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Native",
      "type": "process",
      "command": "cmake",
      "args": ["--workflow", "--preset", "release"],
      "options": { "cwd": "${workspaceFolder}/native" },
      "problemMatcher": []
    },
    {
      "label": "Build All",
      "type": "dotEsp",
      "task": "buildAll",
      "dependsOn": "Build Native",
      "problemMatcher": []
    },
    {
      "label": "Package Cloudfits",
      "type": "process",
      "command": "zip",
      "args": ["-r", "-FS", "../Cloudfits.zip", ".", "-x", ".*"],
      "options": { "cwd": "${workspaceFolder}/build/stage" },
      "dependsOn": "Build All",
      "problemMatcher": []
    }
  ]
}

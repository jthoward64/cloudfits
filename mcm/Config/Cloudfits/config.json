{
  "minMcmVersion": 4,
  "modName": "Cloudfits",
  "displayName": "Cloudfits",
  "pluginRequirements": [
    "Cloudfits.esp"
  ],
  "pages": [
    {
      "pageDisplayName": "Hotkeys",
      "content": [
        {
          "text": "Hotkeys",
          "type": "section"
        },
        {
          "id": "cloudfitsStoreKey",
          "text": "Store outfit",
          "type": "hotkey",
          "help": "Pick a free slot, then choose whether to store what you are wearing or fill it by hand."
        },
        {
          "id": "cloudfitsWearKey",
          "text": "Wear outfit",
          "type": "hotkey",
          "help": "Pick a stored slot. Whatever you still wear from the last one goes back to it first."
        },
        {
          "type": "spacer",
          "numLines": 1
        },
        {
          "text": "Diagnostics",
          "type": "section"
        },
        {
          "id": "bLogging:Cloudfits",
          "text": "Write Cloudfits.log",
          "type": "switcher",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "help": "Appends what Cloudfits does to Cloudfits.log next to Fallout4.exe. Needs SUP F4SE; without it this does nothing."
        },
        {
          "type": "spacer",
          "numLines": 1
        },
        {
          "text": "Protected body slots",
          "type": "section"
        },
        {
          "text": "Apparel touching a protected slot is never stored. These slots are shared by scene props, creature skins and hidden effect items.",
          "type": "text",
          "help": ""
        },
        {
          "id": "bSkip53:Slots",
          "text": "Skip slot 53 when storing",
          "type": "switcher",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "help": "[Default: ON] Used by waist attachments and creature skins."
        },
        {
          "id": "bSkip59:Slots",
          "text": "Skip slot 59 when storing",
          "type": "switcher",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "help": "[Default: ON] Used by wearable implants, vertibird armour, creature skins."
        },
        {
          "id": "bSkip60:Slots",
          "text": "Skip slot 60 when storing",
          "type": "switcher",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "help": "[Default: ON] Used by Pip-Boy, power armour frames, full-body skins."
        },
        {
          "id": "bSkip61:Slots",
          "text": "Skip slot 61 when storing",
          "type": "switcher",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "help": "[Default: ON] Used by scene props, gore effects, Pip-Boy replacements."
        },
        {
          "type": "spacer",
          "numLines": 1
        },
        {
          "text": "Setup",
          "type": "section"
        },
        {
          "text": "Install / repair",
          "type": "button",
          "help": "Starts the quest and re-registers everything. Safe to press any time; does nothing if all is well.",
          "action": {
            "type": "CallFunction",
            "form": "Cloudfits.esp|800",
            "scriptName": "Cloudfits:Manager",
            "function": "Install",
            "params": []
          }
        },
        {
          "text": "Uninstall",
          "type": "button",
          "help": "Empties every slot into your inventory and stops the mod, so it can be removed without losing items.",
          "action": {
            "type": "CallFunction",
            "form": "Cloudfits.esp|800",
            "scriptName": "Cloudfits:Manager",
            "function": "Uninstall",
            "params": []
          }
        }
      ]
    },
    {
